{
  "name": "shike-coffee-mini-program",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "node --test",
    "admin": "npm run build:admin && node admin/server.js",
    "build:admin": "esbuild admin/cloudbase-client.js --bundle --format=iife --outfile=admin/cloudbase.bundle.js",
    "build:functions": "esbuild cloudfunctions/order-api/index.js --bundle --platform=node --target=node20 --packages=external --outfile=cloudfunctions/order-api/dist/index.js && esbuild cloudfunctions/get-login-ticket/index.js --bundle --platform=node --target=node20 --packages=external --outfile=cloudfunctions/get-login-ticket/dist/index.js"
  },
  "dependencies": {
    "@cloudbase/adapter-wx_mp": "1.3.1",
    "@cloudbase/js-sdk": "2.27.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
