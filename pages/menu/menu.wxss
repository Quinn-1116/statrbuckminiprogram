.page-shell {
  padding: 30rpx 30rpx 56rpx;
}

.intro {
  padding: 16rpx 2rpx 30rpx;
}

.eyebrow {
  color: #597568;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.page-title {
  margin-top: 10rpx;
  color: #202722;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.25;
}

.page-subtitle {
  margin-top: 8rpx;
  color: #737d77;
  font-size: 25rpx;
}

.menu-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.drink-card {
  position: relative;
  display: flex;
  min-height: 132rpx;
  align-items: center;
  padding: 18rpx;
  border: 2rpx solid #e5e9e4;
  border-radius: 8rpx;
  background: #fff;
}

.drink-card-selected {
  border-color: #39745b;
  box-shadow: 0 0 0 2rpx rgba(57, 116, 91, 0.08);
}

.drink-mark {
  display: flex;
  width: 92rpx;
  height: 92rpx;
  flex: 0 0 92rpx;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
}

.mark-americano {
  background: #e7eee9;
}

.mark-latte {
  background: #f7e9df;
}

.mark-mocha {
  background: #efe4dc;
}

.mark-ring {
  display: flex;
  width: 56rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(44, 66, 54, 0.72);
  border-radius: 50%;
}

.mark-latte .mark-ring {
  border-color: rgba(168, 99, 60, 0.72);
}

.mark-mocha .mark-ring {
  border-color: rgba(104, 65, 48, 0.76);
}

.mark-core {
  width: 25rpx;
  height: 25rpx;
  border-radius: 50%;
  background: rgba(44, 66, 54, 0.8);
}

.mark-latte .mark-core {
  background: rgba(200, 133, 91, 0.9);
}

.mark-mocha .mark-core {
  background: rgba(113, 70, 49, 0.88);
}

.drink-copy {
  min-width: 0;
  flex: 1;
  padding: 0 14rpx 0 18rpx;
}

.drink-name {
  color: #232b26;
  font-size: 29rpx;
  font-weight: 700;
}

.drink-description {
  margin-top: 7rpx;
  color: #7c8580;
  font-size: 21rpx;
  line-height: 1.4;
}

.drink-price {
  flex: 0 0 auto;
  color: #2f644e;
  font-size: 27rpx;
  font-weight: 700;
}

.price-unit {
  margin-left: 3rpx;
  color: #768079;
  font-size: 20rpx;
  font-weight: 400;
}

.selected-mark {
  position: absolute;
  top: 0;
  right: 0;
  width: 34rpx;
  height: 34rpx;
  border-radius: 0 6rpx 0 8rpx;
  background: #39745b;
  color: #fff;
  font-size: 20rpx;
  line-height: 34rpx;
  text-align: center;
}

.customizer {
  margin-top: 26rpx;
  padding: 24rpx 22rpx 20rpx;
  border: 1rpx solid #e5e9e4;
  border-radius: 8rpx;
  background: #fff;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 8rpx;
}

.section-title {
  color: #232b26;
  font-size: 29rpx;
  font-weight: 700;
}

.section-caption {
  margin-top: 5rpx;
  color: #7c8580;
  font-size: 21rpx;
}

.live-price {
  color: #b64f3b;
  font-size: 34rpx;
  font-weight: 700;
}

.option-group {
  padding-top: 22rpx;
}

.option-title {
  margin-bottom: 12rpx;
  color: #59635d;
  font-size: 23rpx;
  font-weight: 600;
}

.option-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.option-button {
  min-width: 112rpx;
  min-height: 62rpx;
  padding: 0 20rpx;
  border: 1rpx solid #dfe5df;
  border-radius: 6rpx;
  background: #fff;
  color: #4e5952;
  font-size: 23rpx;
  line-height: 60rpx;
  text-align: center;
}

.option-selected {
  border-color: #39745b;
  background: #edf4ef;
  color: #28583f;
  font-weight: 600;
}

.price-note {
  margin-top: 24rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf0ec;
  color: #7c8580;
  font-size: 21rpx;
}

.selection-summary {
  display: flex;
  min-height: 112rpx;
  align-items: center;
  margin-top: 18rpx;
  padding: 14rpx 20rpx;
  border-radius: 8rpx;
  background: #eaf1ec;
}

.summary-copy {
  min-width: 0;
  flex: 1;
}

.summary-label {
  color: #607067;
  font-size: 21rpx;
}

.summary-name {
  margin-top: 4rpx;
  color: #27332c;
  font-size: 24rpx;
  font-weight: 600;
}

.summary-details {
  margin-top: 4rpx;
  color: #607067;
  font-size: 20rpx;
  line-height: 1.4;
}

.summary-price {
  flex: 0 0 auto;
  padding-left: 16rpx;
  color: #2f644e;
  font-size: 27rpx;
  font-weight: 700;
}
